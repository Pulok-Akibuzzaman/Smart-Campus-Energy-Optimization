# ==============================================================================
# GridWise — Environment Configuration Template
# Copy this file to '.env' and customize values as needed.
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration
# Supported options:
#   - 'openai'    : Uses OpenAI API (e.g., gpt-4o-mini, gpt-4o)
#   - 'anthropic' : Uses Anthropic Messages API (e.g., claude-3-5-haiku-20241022)
#   - 'groq'      : Uses Groq Cloud API (e.g., llama-3.3-70b-versatile)
#   - 'custom'    : Uses custom OpenAI-compatible endpoint (Ollama, vLLM, proxy)
#   - 'offline'   : Zero-network fallback using built-in deterministic calibrator
LLM_PROVIDER=openai

# LLM Authentication & Model
# Leave empty or set LLM_PROVIDER=offline for zero-network local operation
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Optional Custom Gateway / Base URL (e.g. http://localhost:11434/v1 for Ollama)
# LLM_BASE_URL=

# Upstream Request Timeout in Seconds
LLM_TIMEOUT_SECONDS=8.0
