# ──────────── LLM Provider API Keys (NEVER commit real values) ────────────
# Groq — primary, free, fast (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini — fallback #1, free tier (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter — fallback #2, free models available (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Puku.sh — fallback #3, OpenAI-compatible at https://api.puku.sh/v1/chat/completions.
# Currently requires browser-session auth; a pk_live_ bearer alone returns 401.
# Leave unset or remove from LLM_PROVIDER_ORDER if not in use.
PUKU_API_KEY=your_puku_api_key_here

# ──────────── Provider fallback order (comma-separated) ────────────
# Resolved at startup. Unknown providers are silently skipped if their key is absent.
# Supported: groq, gemini, openrouter, puku
LLM_PROVIDER_ORDER=groq,gemini,openrouter

# ──────────── LLM model per provider ────────────
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
PUKU_MODEL=gpt-oss-20b

# ──────────── Service ────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ──────────── LLM request limits ────────────
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1

# ──────────── Local debug UI (gated; OFF by default) ────────────
# Set to true to expose http://host:port/ui for local debugging only.
# Judges and public traffic never see the UI; safe to leave unset.
ENABLE_UI=false
